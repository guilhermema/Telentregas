{
  "private": true,
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "tailwindcss": "3.4.x"
  },
  "scripts": {
    "build:css": "mkdir -p ./app/static/fonts && cp ./node_modules/@fontsource-variable/inter/files/inter-latin-wght-normal.woff2 ./app/static/fonts/ && tailwindcss -i ./app/static/css/input.css -o ./app/static/css/app.css --minify",
    "watch:css": "tailwindcss -i ./app/static/css/input.css -o ./app/static/css/app.css --watch"
  }
}
